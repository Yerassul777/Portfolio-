# Supabase — both values are public by design and inlined into the bundle at
# build time. The publishable key (sb_publishable_...) can only do what RLS
# allows the public or the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI key used by /api/ai-assistant. Server-side only.
OPENAI_API_KEY=

# Set to "true" to switch the AI assistant off without a code change.
AI_ASSISTANT_DISABLED=false

# Not needed: the site never uses the Supabase service-role key. Catalogue
# writes are made by admins under their own session and checked by RLS.
